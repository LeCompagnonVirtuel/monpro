{
  "name": "monpro",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @monpro/api dev",
    "dev:admin": "pnpm --filter @monpro/admin dev",
    "dev:mobile": "pnpm --filter @monpro/mobile start",
    "build:api": "pnpm --filter @monpro/api build",
    "build:admin": "pnpm --filter @monpro/admin build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:migrate": "pnpm --filter @monpro/api prisma:migrate",
    "db:seed": "pnpm --filter @monpro/api prisma:seed",
    "db:generate": "pnpm --filter @monpro/api prisma:generate"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@9.1.0"
}
