# ═══════════════════════════════════════════════════════════
# MONPRO API — Variables d'environnement
# ═══════════════════════════════════════════════════════════

# Database (Railway fournit automatiquement DATABASE_URL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/monpro?schema=public"

# JWT — OBLIGATOIRE: générer avec `openssl rand -hex 32`
JWT_SECRET="CHANGE_ME_IN_PRODUCTION"

# OTP Provider: "dev" (logs to console) | "africas_talking"
OTP_PROVIDER="dev"
# Africa's Talking — https://africastalking.com
# AFRICAS_TALKING_API_KEY=""
# AFRICAS_TALKING_USERNAME="sandbox"
# AFRICAS_TALKING_SENDER_ID=""
# AFRICAS_TALKING_ENVIRONMENT="sandbox"

# Server
PORT=3000
NODE_ENV="development"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:8081"

# Storage: "local" | "s3" | "cloudinary"
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./uploads"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET=""
# AWS_REGION=""
# CLOUDINARY_URL=""

# Push Notifications (Expo) — REQUIRES_EXTERNAL_CONFIGURATION
# Provider: "dev" (logs to console) | "expo"
PUSH_NOTIFICATION_PROVIDER="dev"
EXPO_ACCESS_TOKEN=""

# Maps (optionnel pour géolocalisation avancée)
MAPS_API_KEY=""

# Payment providers — REQUIRES_EXTERNAL_CONFIGURATION
# Mode: "dev" (mocked) | "live" (real providers)
PAYMENT_MODE="dev"

# Orange Money
# ORANGE_MONEY_API_URL="https://api.orange.com/orange-money-webpay/dev/v1"
# ORANGE_MONEY_MERCHANT_KEY=""
# ORANGE_MONEY_API_SECRET=""
