# ═══════════════════════════════════════════════════════════
# MONPRO API — Variables d'environnement
# ═══════════════════════════════════════════════════════════

# Database (Railway fournit automatiquement DATABASE_URL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/monpro?schema=public"

# JWT — OBLIGATOIRE: générer avec `openssl rand -hex 32`
JWT_SECRET="CHANGE_ME_IN_PRODUCTION"

# OTP Provider: "dev" (logs to console) | "twilio" | "africas_talking"
OTP_PROVIDER="dev"
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""

# Server
PORT=3000
NODE_ENV="development"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:8081"

# Storage: "local" | "s3" | "cloudinary"
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./uploads"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET=""
# AWS_REGION=""
# CLOUDINARY_URL=""

# Push Notifications (Expo) — REQUIRES_EXTERNAL_CONFIGURATION
EXPO_ACCESS_TOKEN=""

# Maps (optionnel pour géolocalisation avancée)
MAPS_API_KEY=""

# Payment providers — REQUIRES_EXTERNAL_CONFIGURATION
# Actuellement MOCKED en mode dev
# ORANGE_MONEY_API_KEY=""
# ORANGE_MONEY_MERCHANT_ID=""
# MTN_MOMO_API_KEY=""
# MTN_MOMO_SUBSCRIPTION_KEY=""
# WAVE_API_KEY=""
# WAVE_MERCHANT_ID=""
