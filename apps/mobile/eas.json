{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3000/api/v1"
      },
      "pnpm": "9.15.5"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://monpro-api.onrender.com/api/v1",
        "EXPO_PUBLIC_SENTRY_DSN": "",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "preview"
      },
      "pnpm": "9.15.5"
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://monpro-api.onrender.com/api/v1",
        "EXPO_PUBLIC_SENTRY_DSN": "",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "production"
      },
      "pnpm": "9.15.5"
    }
  },
  "submit": {
    "production": {},
    "preview": {}
  }
}
