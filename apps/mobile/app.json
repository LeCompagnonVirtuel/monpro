{
  "expo": {
    "name": "MONPRO",
    "slug": "monpro",
    "owner": "compagnon-labs-dev",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "monpro",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#071F49"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.monpro.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "MONPRO utilise votre position pour trouver des professionnels proches de vous.",
        "NSCameraUsageDescription": "MONPRO a besoin d'accéder à la caméra pour prendre des photos.",
        "NSPhotoLibraryUsageDescription": "MONPRO a besoin d'accéder à vos photos pour les joindre à vos demandes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#071F49"
      },
      "package": "com.monpro.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-location",
      "expo-image-picker",
      "expo-notifications",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "d960d447-441b-45e2-a720-6531725e7b8f"
      },
      "router": {
        "origin": false
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
