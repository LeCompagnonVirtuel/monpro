# ═══════════════════════════════════════════════════════════
# MONPRO VPS — Variables de production
# Copier vers .env sur le serveur et remplir les valeurs
# NE PAS mettre de vrais secrets ici (ce fichier est sur Git)
# ═══════════════════════════════════════════════════════════

# ── REQUIRED ──────────────────────────────────────────────
# PostgreSQL (auto-généré par setup-vps.sh)
POSTGRES_PASSWORD=CHANGE_ME_USE_openssl_rand_hex_32

# JWT — OBLIGATOIRE: générer avec `openssl rand -hex 32`
JWT_SECRET=CHANGE_ME_USE_openssl_rand_hex_32

# Server
NODE_ENV=production
PORT=3000
CORS_ORIGINS=https://srv1288413.hstgr.cloud

# ── STORAGE (cloudinary) ─────────────────────────────────
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── OTP / SMS ─────────────────────────────────────────────
# Provider: "dev" (logs to console) | "africas_talking" (real SMS)
OTP_PROVIDER=dev
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_SENDER_ID=
AFRICAS_TALKING_ENVIRONMENT=sandbox

# ── PUSH NOTIFICATIONS ───────────────────────────────────
# Provider: "dev" (logs to console) | "expo" (real push)
PUSH_NOTIFICATION_PROVIDER=dev
EXPO_ACCESS_TOKEN=

# ── PAYMENTS ──────────────────────────────────────────────
# Mode: "dev" (mocked) | "live" (real providers)
PAYMENT_MODE=dev

# Orange Money
ORANGE_MONEY_API_URL=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_API_SECRET=
ORANGE_MONEY_ACCESS_TOKEN=
ORANGE_MONEY_WEBHOOK_SECRET=

# MTN Mobile Money
MTN_MOMO_API_URL=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_KEY=
MTN_MOMO_USER_ID=
MTN_MOMO_ENV=sandbox
MTN_MOMO_WEBHOOK_SECRET=

# Moov Money
MOOV_MONEY_API_URL=
MOOV_MONEY_MERCHANT_ID=
MOOV_MONEY_API_KEY=
MOOV_MONEY_WEBHOOK_SECRET=

# Wave
WAVE_API_URL=
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=

# ── AI ────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── MONITORING ────────────────────────────────────────────
SENTRY_DSN=
