# ═══════════════════════════════════════════════════════════
# MONPRO VPS — Variables de production
# Copier vers .env sur le serveur et remplir les valeurs
# ═══════════════════════════════════════════════════════════

# PostgreSQL
POSTGRES_PASSWORD=CHANGE_ME_USE_openssl_rand_hex_32

# JWT — OBLIGATOIRE: générer avec `openssl rand -hex 32`
JWT_SECRET=CHANGE_ME_USE_openssl_rand_hex_32

# CORS
CORS_ORIGINS=https://srv1288413.hstgr.cloud

# Storage: cloudinary
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OTP Provider: "dev" | "africas_talking"
OTP_PROVIDER=dev
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_SENDER_ID=
AFRICAS_TALKING_ENVIRONMENT=sandbox

# Push Notifications: "dev" | "expo"
PUSH_NOTIFICATION_PROVIDER=dev
EXPO_ACCESS_TOKEN=

# Payment: "dev" | "live"
PAYMENT_MODE=dev

# AI
OPENAI_API_KEY=

# Sentry
SENTRY_DSN=
